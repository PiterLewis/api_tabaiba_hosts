# ============================================================
# Tabaiba API — variables de entorno
# Copia a `.env` para desarrollo local. En producción se inyectan via Coolify.
# ============================================================

# --- Servidor ---
PORT=5001
NODE_ENV=development
LOG_LEVEL=info

# --- Base de datos ---
# En local: Postgres propio (Docker o nativo). En Coolify: lo da el Database service.
# Coolify expone la URL como POSTGRES_URL o DATABASE_URL en la red interna.
DATABASE_URL=postgresql://tabaiba:CHANGEME@localhost:5432/tabaiba_dev?schema=public&connection_limit=20

# --- Auth ---
# Genera con: openssl rand -base64 64
JWT_SECRET=CHANGEME_GENERATE_WITH_OPENSSL_RAND_BASE64_64
JWT_EXPIRES_IN=1h
REFRESH_TOKEN_SECRET=CHANGEME_GENERATE_DIFFERENT_SECRET
REFRESH_TOKEN_EXPIRES_IN=30d

# Whitelist de admins (separados por coma). Solo estos emails pueden hacer login.
ADMIN_EMAILS=tuemail@example.com

# --- CORS ---
# Orígenes permitidos, separados por coma.
CORS_ORIGIN=http://localhost:3000

# --- Swagger UI (basic auth) ---
SWAGGER_USER=admin
SWAGGER_PASS=CHANGEME

# --- Negocio ---
TIMEZONE=Atlantic/Canary

# --- Telegram (Fase C — puede estar vacío en Fase A) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
